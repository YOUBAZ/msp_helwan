# Port the API listens on locally (the website expects http://localhost:4001/api)
PORT=4001
# Comma-separated list of allowed website origins
CORS_ORIGIN=http://localhost:3001
# Website address used to build invitation / password-reset links
# (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:3001

# PostgreSQL connection string.
# - Production: your Neon database (REQUIRED).
# - Local with Docker (recommended): run "docker compose up -d" in the project
#   root and use: postgres://msp:msp_local_dev@localhost:5433/msp_helwan
# - Leave empty to use the built-in database saved in DATA_DIR/pglite.
DATABASE_URL=postgres://msp:msp_local_dev@localhost:5433/msp_helwan
DATA_DIR=data

# Long random string used to sign logins. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First President account(s), used ONLY when the database has no users yet:
# email:bcryptHash, comma-separated. Create a hash with:
#   npm run hash-password -- "the-password"
# After that, invite everyone else from the dashboard.
BOARD_ACCOUNTS=

# Email (SMTP). Leave SMTP_HOST empty to disable email: links are then shown
# on screen to copy instead.
# - Local: "docker compose up -d" runs Mailpit; see the emails at http://localhost:8025
#     SMTP_HOST=localhost  SMTP_PORT=1025
# - Production with Gmail: turn on 2-Step Verification for the club Gmail, create an
#   App Password (myaccount.google.com/apppasswords), then:
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#     SMTP_USER=microsoftstudentpartners@gmail.com  SMTP_PASS=<16-letter app password>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients (defaults to "MSP Tech Club <SMTP_USER>")
MAIL_FROM=
# Where contact-form notifications go (defaults to SMTP_USER)
CONTACT_NOTIFY_TO=
