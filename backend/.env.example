# Port the API listens on locally (the website expects http://localhost:4001/api)
PORT=4001
# Comma-separated list of allowed website origins
CORS_ORIGIN=http://localhost:3001
# Website address used to build invitation / password-reset links
# (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:3001

# PostgreSQL connection string, e.g. a free Neon database (neon.tech).
# REQUIRED in production. Leave empty locally to use the built-in database,
# which is saved in DATA_DIR/pglite.
DATABASE_URL=
DATA_DIR=data

# Long random string used to sign logins. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First President account(s), used ONLY when the database has no users yet:
# email:bcryptHash, comma-separated. Create a hash with:
#   npm run hash-password -- "the-password"
# After that, invite everyone else from the dashboard.
BOARD_ACCOUNTS=
