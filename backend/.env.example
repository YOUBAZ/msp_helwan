# Port the API listens on (frontend expects http://localhost:4001/api by default)
PORT=4001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3001
# Where contact messages and newsletter subscribers are stored (JSON files)
DATA_DIR=data
# Long random string used to sign login tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Board accounts that can log in to /dashboard: email:bcryptHash, comma-separated.
# Create a hash with: npm run hash-password -- "the-password"
BOARD_ACCOUNTS=
